# Copy to .env.local and fill in.

# Required for AI study sheets (everything else works without it).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: require a password to open the app. Set this whenever the app is
# reachable from the internet, so nobody else can use your notes or API key.
APP_PASSWORD=

# Optional: where the database and uploaded PDFs are stored. Defaults to ./data
# DATA_DIR=/data

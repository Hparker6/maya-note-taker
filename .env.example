# Copy to .env.local and fill in. Everything here is optional.

# AI keys can be pasted in the app instead (sidebar → Set up free AI).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude key (paid per use): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Require a password to open the app. Set this whenever the app is
# reachable from the internet, so nobody else can use your notes or AI keys.
APP_PASSWORD=

# Where the database and uploaded PDFs are stored. Defaults to ./data
# DATA_DIR=/data
